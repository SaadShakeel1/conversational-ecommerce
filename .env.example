# Backend (Neon/Postgres connection and API keys)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/conversational_ecommerce
VECTOR_DB_API_KEY=
GROQ_API_KEY=

# Pinecone vector database (for RAG)
PINECONE_INDEX_NAME=
PINECONE_HOST=
PINECONE_NAMESPACE=default

# Embeddings (must match the Pinecone index dimension)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth
JWT_SECRET_KEY=change_me_to_a_long_random_secret
